const {
  app, PDFCrop, RulerOrigin, MeasurementUnits, PageSideOptions,
} = require("indesign");
const fs = require("uxp").storage.localFileSystem;

// 前回の入力値をドキュメントに保存するキー
const LABEL_KEY = "techbook-template:place-tobira";

function loadSettings(doc) {
  const defaults = {
    usesHontobira: true,
    hontobiraPage: 1,
    usesTobira: true,
    tobiraPages: "",
    bleed: 3,
  };
  try {
    const saved = doc.extractLabel(LABEL_KEY);
    return saved ? { ...defaults, ...JSON.parse(saved) } : defaults;
  } catch {
    return defaults;
  }
}

// 「10, 62, 131」のような入力を物理ページ番号（1始まり）の配列に変換する．
function parsePages(text) {
  const tokens = text.split(/[\s,，、]+/).filter((token) => token !== "");
  return tokens.map((token) => {
    if (!/^\d+$/.test(token) || Number(token) < 1) {
      throw new Error(`部扉のページ番号が不正です：${token}`);
    }
    return Number(token);
  });
}

// 配置設定をダイアログで入力する．キャンセル時は null を返す．
function askSettings(doc) {
  const settings = loadSettings(doc);
  const dialog = app.dialogs.add({ name: "扉を配置", canCancel: true });
  try {
    const col = dialog.dialogColumns.add();
    col.staticTexts.add({
      staticLabel: "ページ番号は物理ページ番号（1始まり）で指定してください．",
    });

    const hontobiraGroup = col.enablingGroups.add({
      staticLabel: "本扉を配置",
      checkedState: settings.usesHontobira,
    });
    const hontobiraCol = hontobiraGroup.dialogColumns.add();
    hontobiraCol.staticTexts.add({ staticLabel: "配置先のページ番号" });
    const inputHontobiraPage = hontobiraCol.integerEditboxes.add({
      editValue: settings.hontobiraPage,
      minimumValue: 1,
      maximumValue: 99999,
    });

    const tobiraGroup = col.enablingGroups.add({
      staticLabel: "部扉を配置",
      checkedState: settings.usesTobira,
    });
    const tobiraCol = tobiraGroup.dialogColumns.add();
    tobiraCol.staticTexts.add({
      staticLabel: "配置先のページ番号（カンマ区切り．PDF の1ページ目から順に配置）",
    });
    const inputTobiraPages = tobiraCol.textEditboxes.add({
      editContents: settings.tobiraPages,
      minWidth: 240,
    });

    col.staticTexts.add({ staticLabel: "部扉のノド側で隠す塗り足し（mm）" });
    const inputBleed = col.realEditboxes.add({
      editValue: settings.bleed,
      minimumValue: 0,
      maximumValue: 100,
    });

    col.staticTexts.add({
      staticLabel: "OK を押すと，本扉 → 部扉の順に PDF の選択画面が開きます．",
    });

    if (!dialog.show()) {
      return null;
    }
    const result = {
      usesHontobira: hontobiraGroup.checkedState,
      hontobiraPage: inputHontobiraPage.editValue,
      usesTobira: tobiraGroup.checkedState,
      tobiraPages: inputTobiraPages.editContents,
      bleed: inputBleed.editValue,
    };
    doc.insertLabel(LABEL_KEY, JSON.stringify(result));
    return result;
  } finally {
    dialog.destroy();
  }
}

async function main() {
  if (app.documents.length === 0) {
    throw new Error("InDesign のドキュメントを開いてください．");
  }
  const doc = app.activeDocument;

  const settings = askSettings(doc);
  if (!settings) {
    return;
  }
  const tobiraPages = settings.usesTobira
    ? parsePages(settings.tobiraPages)
    : [];
  if (!settings.usesHontobira && tobiraPages.length === 0) {
    throw new Error("配置する扉がありません．");
  }

  const lastPage = Math.max(
    settings.usesHontobira ? settings.hontobiraPage : 0,
    ...tobiraPages,
  );
  if (doc.pages.length < lastPage) {
    throw new Error(
      `配置先の p${lastPage} がありません．本文を配置した文書を開いてください．`,
    );
  }

  // isHontobira: 本扉はそのまま，部扉はノド側の塗り足しを隠す
  const placements = [];
  if (settings.usesHontobira) {
    const file = await fs.getFileForOpening({ types: ["pdf"] });
    if (!file) {
      return;
    }
    placements.push({
      page: settings.hontobiraPage, file, pdfPage: 1, isHontobira: true,
    });
  }
  if (tobiraPages.length > 0) {
    const file = await fs.getFileForOpening({ types: ["pdf"] });
    if (!file) {
      return;
    }
    tobiraPages.forEach((page, i) => {
      placements.push({ page, file, pdfPage: i + 1, isHontobira: false });
    });
  }

  const prefs = app.pdfPlacePreferences;
  const view = doc.viewPreferences;
  const original = {
    pageNumber: prefs.pageNumber,
    pdfCrop: prefs.pdfCrop,
    horizontal: view.horizontalMeasurementUnits,
    vertical: view.verticalMeasurementUnits,
    rulerOrigin: view.rulerOrigin,
    zeroPoint: doc.zeroPoint,
  };

  try {
    view.horizontalMeasurementUnits = MeasurementUnits.MILLIMETERS;
    view.verticalMeasurementUnits = MeasurementUnits.MILLIMETERS;
    view.rulerOrigin = RulerOrigin.PAGE_ORIGIN;
    doc.zeroPoint = [0, 0];
    // TrimBoxで切り落とさず，塗り足しを含む用紙全体を等倍配置．
    prefs.pdfCrop = PDFCrop.CROP_MEDIA;

    const bleed = settings.bleed;
    for (const { page: pageNumber, file, pdfPage, isHontobira } of placements) {
      const page = doc.pages.item(pageNumber - 1);
      const oldFrames = [];
      for (const graphic of page.allGraphics) {
        // UXPのDOMオブジェクトはconstructor.nameで判別できない場合がある．
        // PDF固有の属性を読めるかどうかで判定する．
        let isPdf = false;
        try {
          isPdf = graphic.pdfAttributes.pageNumber > 0;
        } catch {
          // 画像など，PDF以外のグラフィックは残す．
        }
        if (isPdf) {
          const frame = graphic.parent;
          if (!oldFrames.some((item) => item.id === frame.id)) {
            oldFrames.push(frame);
          }
        }
      }
      // 配置成功を確認してから，置換対象のPDFフレームを削除する．
      prefs.pageNumber = pdfPage;
      const graphic = page.place(file, [-bleed, -bleed])[0];
      try {
        if (graphic.pdfAttributes.pageNumber !== pdfPage) {
          throw new Error(`${file.name} に PDF p${pdfPage} がありません．`);
        }
        if (!isHontobira) {
          const newFrame = graphic.parent;
          newFrame.frameFittingOptions.autoFit = false;
          const bounds = newFrame.geometricBounds;
          // UXPの列挙値はオブジェクトとして返るため，数値で比較する．
          const side = Number(page.side);
          if (side === Number(PageSideOptions.LEFT_HAND)) {
            bounds[3] -= bleed;
          } else if (side === Number(PageSideOptions.RIGHT_HAND)) {
            bounds[1] += bleed;
          }
          newFrame.geometricBounds = bounds;
        }
        for (const frame of oldFrames) {
          frame.remove();
        }
        console.log(`p${pageNumber}: 既存PDFを${oldFrames.length}件削除`);
      } catch (error) {
        graphic.parent.remove();
        throw error;
      }
      console.log(
        `p${pageNumber}: ${file.name} の p${pdfPage} を (-${bleed} mm, -${bleed} mm) に配置`,
      );
    }
  } finally {
    prefs.pageNumber = original.pageNumber;
    prefs.pdfCrop = original.pdfCrop;
    view.rulerOrigin = original.rulerOrigin;
    doc.zeroPoint = original.zeroPoint;
    view.horizontalMeasurementUnits = original.horizontal;
    view.verticalMeasurementUnits = original.vertical;
  }
  console.log(`扉を${placements.length}か所配置しました．`);
}

try {
  await main();
} catch (error) {
  console.error("扉の配置エラー:", error);
  const dialog = app.dialogs.add({ name: "扉の配置エラー", canCancel: false });
  try {
    dialog.dialogColumns.add().staticTexts.add({ staticLabel: String(error) });
    dialog.show();
  } finally {
    dialog.destroy();
  }
}
