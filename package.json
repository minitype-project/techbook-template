{
  "name": "techbook-template",
  "version": "0.1.0",
  "description": "Techbook template using minitype",
  "author": "Yuto Wada",
  "license": "MIT",
  "homepage": "https://github.com/minitype-project/techbook-template",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minitype-project/techbook-template.git"
  },
  "bugs": {
    "url": "https://github.com/minitype-project/techbook-template/issues"
  },
  "keywords": [
    "minitype",
    "typesetting",
    "technical book",
    "jsx",
    "markdown",
    "pdf"
  ],
  "type": "module",
  "scripts": {
    "dev": "tsx scripts/dev.ts",
    "build": "tsx scripts/build.ts",
    "build:all": "BUILD_ALL=1 tsx scripts/build.ts",
    "build:toc": "BUILD_TOC=1 tsx scripts/build.ts",
    "build:tobira": "BUILD_TOBIRA=1 tsx scripts/build.ts",
    "build:tobira-padding": "BUILD_TOBIRA_PADDING=1 tsx scripts/build.ts",
    "sample": "tsx scripts/generate-sample.ts",
    "diff": "tsx scripts/diff-pdf.ts",
    "format": "biome check --write",
    "test": "vitest run",
    "prepare": "husky"
  },
  "dependencies": {
    "@minitype/minitype": "^0.2.0",
    "@minitype/tsx": "^0.2.2"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.9",
    "@biomejs/js-api": "^6.1.0",
    "@biomejs/wasm-nodejs": "^2.6.9",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@minitype/vite-plugin": "^0.3.1",
    "@types/node": "^26.6.6",
    "husky": "^9.1.7",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.7.284",
    "tsx": "~4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
